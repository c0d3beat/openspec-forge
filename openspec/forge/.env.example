# Forge secrets — copy to `.env` (gitignored) and fill in. NEVER commit real tokens.
# Non-secret hosts/keys live in connections.yaml; only secrets belong here.

# GitHub (Free + private repo): a Personal Access Token with `repo` scope (used by gh/REST).
GITHUB_TOKEN=

# SonarQube (self-hosted, Community Edition). SONAR_HOST_URL overrides connections.yaml.
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=

# JIRA (Atlassian Cloud): email + API token → basic auth. JIRA_BASE_URL overrides connections.yaml.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=

# Confluence (Atlassian Cloud): email + API token. CONFLUENCE_BASE_URL overrides connections.yaml.
CONFLUENCE_BASE_URL=https://your-org.atlassian.net/wiki
CONFLUENCE_EMAIL=
CONFLUENCE_TOKEN=
